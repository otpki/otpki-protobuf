{
  "name": "@otpki/otpki-protobuf",
  "version": "0.1.0",
  "description": "Generated TypeScript types and Connect-Query clients for OTPKI protobuf definitions",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./es/gen/public/*.d.ts",
      "default": "./es/gen/public/*.js"
    },
    "./specs/*": {
      "default": "./es/gen/specs/*"
    }
  },
  "files": [
    "es/gen/**/*",
    "proto/**/*"
  ],
  "scripts": {
    "generate": "buf generate --template buf.gen.frontend.yaml"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@connectrpc/protoc-gen-connect-query": "^2.2.0"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-query": "^2.2.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otpki/otpki-protobuf.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
